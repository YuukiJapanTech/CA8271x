;;please enter app-cli config/aal/l3_cls tree before sending the following commands

;;clean spcl pkt key fields in key table index 64
sendln 'key_clean 64 4'

;;set the key of o_lspid
sendln 'spcl_pkt_key o_lspid_0 64 0x19'
sendln 'spcl_pkt_key msk_o_lspid_0 64 0'

;;set the key of ip_protocol to UDP
sendln 'spcl_pkt_key ip_protocol_0 64 17'
sendln 'spcl_pkt_key msk_ip_protocol_0 64 0'

;;set the key of ip_options to IPv4
sendln 'spcl_pkt_key ip_options_0 64 1'
sendln 'spcl_pkt_key msk_ip_options_0 64 0'

;;enable the key
sendln 'spcl_pkt_key cls_key_valid 64 1'
sendln 'spcl_pkt_key cls_pri 64 10'
sendln 'spcl_pkt_key cls_rslt_type 64 1'

;;clean fib 3 fields in fib table index 256
sendln 'fib_clean 256 3'

;;set the fib of ip_sa_0 to 172.10.10.100
sendln 'fib_3 ip_sa_l_vld 256 1'
sendln 'fib_3 ip_sa_0 256 0xac0a0a64'

;;set the fib of l4_sp to 100
sendln 'fib_3 l4_sp_vld 256 1'
sendln 'fib_3 l4_sp 256 100'

;;show key and fib settings
sendln 'show aal l3_cls spcl_pkt_key 64'
sendln 'show aal l3_cls fib_3 256'

