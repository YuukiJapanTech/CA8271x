;;please enter app-cli config/aal/l3_cls tree before sending the following commands

;;clean if id key fields in key table index 64
sendln 'key_clean 64 0'

;;set the key of mac_da_ip_mc to 1
sendln 'if_id_key mac_da_ip_mc_0 64 1'
sendln 'if_id_key msk_mac_da_ip_mc_0 64 0'

;;enable the key
sendln 'if_id_key cls_key_valid 64 1'
sendln 'if_id_key cls_pri 64 10'
sendln 'if_id_key cls_rslt_type 64 1'

;;clean fib 0 fields in fib table index 256
sendln 'fib_clean 256 0'

;;set the fib of vlan_cnt to 0 (untag)
sendln 'fib_0 vlan_cnt 256 0'
sendln 'fib_0 vlan_vld 256 1'

;;show key and fib settings
sendln 'show aal l3_cls if_id_key 64'
sendln 'show aal l3_cls fib_0 256'

