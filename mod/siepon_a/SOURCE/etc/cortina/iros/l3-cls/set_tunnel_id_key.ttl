;;please enter app-cli config/aal/l3_cls tree before sending the following commands

;;clean tunnel id key fields in key table index 64
sendln 'key_clean 64 1'

;;set the key of ip_da_sa_equal to 1
sendln 'tunnel_id_key ip_da_sa_equal 64 1'
sendln 'tunnel_id_key msk_ip_da_sa_equal 64 0'

;;enable the key
sendln 'tunnel_id_key cls_key_valid 64 1'
sendln 'tunnel_id_key cls_pri 64 10'
sendln 'tunnel_id_key cls_rslt_type 64 1'

;;clean fib 0 fields in fib table index 256
sendln 'fib_clean 256 0'

;;set the fib of permit to 0 (drop packet)
sendln 'fib_0 permit 256 0'
sendln 'fib_0 dpid_vld 256 1'

;;show key and fib settings
sendln 'show aal l3_cls tunnel_id_key 64'
sendln 'show aal l3_cls fib_0 256'

